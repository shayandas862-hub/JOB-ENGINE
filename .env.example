# Copy this file to .env and fill in the values. NEVER commit .env.
#
# Supabase Postgres connection string.
# Grab the URI from Supabase > Project Settings > Database > Connection string,
# then replace [YOUR-PROJECT-REF] and [YOUR-PASSWORD] below.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API key (JD reading + synonym mapping; blank = keyword fallback).
GEMINI_API_KEY=

# Aggregator job-search APIs (Phase 6 discovery). Both are FREE.
#   Adzuna: register at https://developer.adzuna.com/ -> gives an App ID + App Key.
#   Reed:   register at https://www.reed.co.uk/developers -> gives one API Key.
# Blank = that source is skipped (discovery still runs on the others).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=

# Notion application tracker (Phase 7 filing). Create an internal integration at
# https://www.notion.so/my-integrations, share a page with it, then:
#   NOTION_TOKEN         = the integration's secret (starts 'ntn_'/'secret_')
#   NOTION_PARENT_PAGE_ID= the shared page's id (the engine creates the tracker under it)
#   NOTION_DATABASE_ID   = the Applications database id (set after first creation)
# Blank token = filing is skipped (the rest of the loop still runs).
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# Companies House (Phase 7.5 census sweep — the UK national-registry plug-in). FREE.
# Register at https://developer.company-information.service.gov.uk/ -> create an
# application -> REST API key. Sent as Basic-auth username (blank password).
# Blank = the census sweep still runs, probe-only (registry enrichment skipped).
COMPANIES_HOUSE_API_KEY=

# Supabase project URL — Supabase > Project Settings > Data API > Project URL.
# ONLY the hosted MCP door uses it, and only to verify Google sign-in tokens:
# it derives the issuer and the JWKS endpoint from this URL. Setting it is what
# switches the stranger tier ON; blank = friend-tier keys only, and every JWT
# is refused. Not a credential (the URL is public), but it carries the project
# ref, so it never goes into a committed file.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Salary thresholds live in the database (my_constraints / soc_going_rates),
# not in environment variables.
